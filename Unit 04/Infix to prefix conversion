
#include <iostream>
#include <stack>
#include <algorithm>
using namespace std;

int priority(char c) {
    if (c == '^') return 3;
    if (c == '*' || c == '/') return 2;
    if (c == '+' || c == '-') return 1;
    return 0;
}

int main() {
    string s = "A+B*C";
    reverse(s.begin(), s.end());

    for (char &c : s) {
        if (c == '(') c = ')';
        else if (c == ')') c = '(';
    }

    stack<char> st;
    string ans = "";

    for (char c : s) {
        if (isalnum(c))
            ans += c;

        else if (c == '(')
            st.push(c);

        else if (c == ')') {
            while (!st.empty() && st.top() != '(') {
                ans += st.top();
                st.pop();
            }
            if (!st.empty()) st.pop();
        }

        else {
            while (!st.empty() && st.top() != '(' &&
                  (priority(st.top()) > priority(c) ||
                  (priority(st.top()) == priority(c) && c == '^'))) {
                ans += st.top();
                st.pop();
            }
            st.push(c);
        }
    }

    while (!st.empty()) {
        ans += st.top();
        st.pop();
    }

    reverse(ans.begin(), ans.end());

    cout << "Prefix: " << ans;
    return 0;
}
