
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

Node* head = NULL;

void insert(int x, int pos) {
    Node* n = new Node{x, NULL};

    if (pos == 1) {
        n->next = head;
        head = n;
        return;
    }

    Node* temp = head;
    for (int i = 1; i < pos - 1 && temp; i++)
        temp = temp->next;

    if (!temp) return;

    n->next = temp->next;
    temp->next = n;
}

void deleteNode(int pos) {
    if (!head) return;

    Node* temp = head;

    if (pos == 1) {
        head = head->next;
        delete temp;
        return;
    }

    for (int i = 1; i < pos - 1 && temp; i++)
        temp = temp->next;

    if (!temp || !temp->next) return;

    Node* del = temp->next;
    temp->next = del->next;
    delete del;
}

void reverse() {
    Node *prev = NULL, *curr = head, *next;

    while (curr) {
        next = curr->next;
        curr->next = prev;
        prev = curr;
        curr = next;
    }

    head = prev;
}

void display() {
    Node* temp = head;
    while (temp) {
        cout << temp->data << " -> ";
        temp = temp->next;
    }
    cout << "NULL\n";
}

void concatenate(Node* second) {
    if (!head) {
        head = second;
        return;
    }

    Node* temp = head;
    while (temp->next)
        temp = temp->next;

    temp->next = second;
}

int main() {
    insert(10, 1);
    insert(20, 2);
    insert(30, 3);

    cout << "Original: ";
    display();

    insert(15, 2);
    cout << "After Insert: ";
    display();

    deleteNode(2);
    cout << "After Delete: ";
    display();

    reverse();
    cout << "After Reverse: ";
    display();

    Node* second = new Node{40, new Node{50, NULL}};
    concatenate(second);

    cout << "After Concatenate: ";
    display();

    return 0;
}
