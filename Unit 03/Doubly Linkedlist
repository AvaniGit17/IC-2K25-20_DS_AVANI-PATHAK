
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node *prev, *next;
};

Node* head = NULL;

void insert(int x, int pos) {
    Node* n = new Node{x, NULL, NULL};

    if (pos == 1) {
        n->next = head;
        if (head) head->prev = n;
        head = n;
        return;
    }

    Node* temp = head;
    for (int i = 1; i < pos - 1 && temp; i++)
        temp = temp->next;

    if (!temp) return;

    n->next = temp->next;
    n->prev = temp;

    if (temp->next)
        temp->next->prev = n;

    temp->next = n;
}

void deleteNode(int pos) {
    if (!head) return;

    Node* temp = head;

    for (int i = 1; i < pos && temp; i++)
        temp = temp->next;

    if (!temp) return;

    if (temp->prev)
        temp->prev->next = temp->next;
    else
        head = temp->next;

    if (temp->next)
        temp->next->prev = temp->prev;

    delete temp;
}

void reverse() {
    Node* temp = head;

    while (temp) {
        swap(temp->prev, temp->next);

        if (!temp->prev)
            head = temp;

        temp = temp->prev;
    }
}

void display() {
    Node* temp = head;

    while (temp) {
        cout << temp->data << " <-> ";
        temp = temp->next;
    }
    cout << "NULL\n";
}

void concatenate(Node* second) {
    if (!head) {
        head = second;
        if (head) head->prev = NULL;
        return;
    }

    Node* temp = head;

    while (temp->next)
        temp = temp->next;

    temp->next = second;

    if (second)
        second->prev = temp;
}

int main() {
    insert(10, 1);
    insert(20, 2);
    insert(30, 3);

    cout << "Original: ";
    display();

    insert(15, 2);
    cout << "After Insert: ";
    display();

    deleteNode(2);
    cout << "After Delete: ";
    display();

    reverse();
    cout << "After Reverse: ";
    display();

    Node* second = new Node{40, NULL, NULL};
    second->next = new Node{50, second, NULL};

    concatenate(second);

    cout << "After Concatenate: ";
    display();

    return 0;
}
