// recursive 
#include <iostream>
#include <vector>
using namespace std;

vector<int> graph[5];
bool visited[5] = {false};

void DFS(int node) {
    visited[node] = true;
    cout << node << " ";

    for (int x : graph[node]) {
        if (!visited[x])
            DFS(x);
    }
}

int main() {
    graph[0] = {1, 2};
    graph[1] = {0, 3, 4};
    graph[2] = {0};
    graph[3] = {1};
    graph[4] = {1};

    cout << "DFS: ";
    DFS(0);

    return 0;
}

// iterative 
#include <iostream>
#include <vector>
#include <stack>
using namespace std;

int main() {
    vector<int> graph[5];

    graph[0] = {1, 2};
    graph[1] = {0, 3, 4};
    graph[2] = {0};
    graph[3] = {1};
    graph[4] = {1};

    bool visited[5] = {false};
    stack<int> s;

    s.push(0);

    while (!s.empty()) {
        int node = s.top();
        s.pop();

        if (visited[node])
            continue;

        visited[node] = true;
        cout << node << " ";

        for (int i = graph[node].size() - 1; i >= 0; i--) {
            int x = graph[node][i];

            if (!visited[x])
                s.push(x);
        }
    }

    return 0;
}
