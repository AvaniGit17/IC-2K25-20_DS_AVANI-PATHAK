// by adjacency matrix 
#include <iostream>
using namespace std;

int main() {
    int n = 4;
    int graph[4][4] = {0};

    graph[0][1] = 1;
    graph[1][0] = 1;

    graph[0][2] = 1;
    graph[2][0] = 1;

    graph[1][3] = 1;
    graph[3][1] = 1;

    cout << "Adjacency Matrix:\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++)
            cout << graph[i][j] << " ";
        cout << endl;
    }

    return 0;
}
// by adjacency list
#include <iostream>
#include <vector>
using namespace std;

int main() {
    int v = 4;

    vector<int> graph[4];

    graph[0].push_back(1);
    graph[0].push_back(2);

    graph[1].push_back(0);
    graph[1].push_back(3);

    graph[2].push_back(0);
    graph[3].push_back(1);

    for (int i = 0; i < v; i++) {
        cout << i << " -> ";

        for (int x : graph[i])
            cout << x << " ";

        cout << endl;
    }

    return 0;
}
