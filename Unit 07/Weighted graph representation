
#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<pair<int, int>> graph[4];

    graph[0].push_back({1, 10});
    graph[0].push_back({2, 20});

    graph[1].push_back({0, 10});
    graph[1].push_back({3, 30});

    graph[2].push_back({0, 20});
    graph[3].push_back({1, 30});

    for (int i = 0; i < 4; i++) {
        cout << i << " -> ";

        for (auto x : graph[i])
            cout << "(" << x.first << "," << x.second << ") ";

        cout << endl;
    }

    return 0;
}
