
#include <iostream>
#include <queue>
using namespace std;

int main() {
    priority_queue<pair<int, int>> q;

    q.push({2, 10});
    q.push({5, 20});
    q.push({1, 30});

    cout << "Priority Queue:\n";

    while (!q.empty()) {
        cout << "Element: " << q.top().second;
        cout << " Priority: " << q.top().first << endl;

        q.pop();
    }

    return 0;
}
