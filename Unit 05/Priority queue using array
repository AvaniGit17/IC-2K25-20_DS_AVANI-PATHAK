
#include <iostream>
using namespace std;

int q[5], p[5], n = 0;

void insert(int x, int priority) {
    if (n == 5) {
        cout << "Queue Full\n";
        return;
    }

    q[n] = x;
    p[n] = priority;
    n++;
}

void deleteItem() {
    if (n == 0) {
        cout << "Queue Empty\n";
        return;
    }

    int pos = 0;

    for (int i = 1; i < n; i++) {
        if (p[i] > p[pos])
            pos = i;
    }

    cout << "Deleted: " << q[pos] << endl;

    for (int i = pos; i < n - 1; i++) {
        q[i] = q[i + 1];
        p[i] = p[i + 1];
    }

    n--;
}

void display() {
    for (int i = 0; i < n; i++)
        cout << q[i] << "(" << p[i] << ") ";
    cout << endl;
}

int main() {
    insert(10, 2);
    insert(20, 5);
    insert(30, 1);

    display();
    deleteItem();
    display();

    return 0;
}
